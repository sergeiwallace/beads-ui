{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "plugins/**",
      "packages/**",
      "scripts/**/*.mjs",
      "*.json",
      "*.ts",
      "!**/test/fixtures",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["plugins/beads-ui/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "setTimeout": "core is timer-free: take a clock function argument",
                  "setInterval": "core is timer-free: take a clock function argument",
                  "queueMicrotask": "core is timer-free",
                  "requestAnimationFrame": "core is DOM-free",
                  "window": "core is DOM-free",
                  "document": "core is DOM-free",
                  "process": "core is Node-free",
                  "console": "core does no I/O"
                }
              }
            }
          }
        }
      }
    }
  ]
}
