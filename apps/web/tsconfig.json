{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@beads-ui/core": ["../../plugins/beads-ui/core/src/index.ts"],
      "@beads-ui/core/*": ["../../plugins/beads-ui/core/src/*"],
      "@/*": ["./client/*"]
    }
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.tsx",
    "src/**/*.ts",
    "server/**/*.ts",
    "test/**/*.ts",
    "*.ts"
  ]
}
