{
  "name": "@sergeiwallace/beads-ui-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "beads-ui-web": "./bin/beads-ui-web.mjs"
  },
  "scripts": {
    "build": "vite build",
    "start": "node bin/beads-ui-web.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "node e2e/check-install.mjs && tsc -p e2e && cd e2e && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-0} ./node_modules/.bin/playwright test -c frontend-harness.config.ts",
    "e2e:install": "node e2e/check-install.mjs --install && cd e2e && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-0} ./node_modules/.bin/playwright install chromium"
  },
  "dependencies": {
    "@babel/core": "7.29.13",
    "@base-ui/react": "1.9.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@sergeiwallace/beads-ui-bd-node": "0.0.0",
    "@sergeiwallace/beads-ui-web-ui": "0.0.0",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "dompurify": "3.4.17",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
