{
  "name": "beads-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "plugins/*",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check . && turbo run lint typecheck",
    "test": "node scripts/test-jobs.mjs turbo run test test:mod --concurrency={jobs}",
    "test:scripts": "node scripts/test-jobs.mjs node --test --test-concurrency={jobs} scripts/*.test.mjs",
    "test:e2e": "npm run test:e2e -w apps/web",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
