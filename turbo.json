{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-core-purity.mjs"],
      "outputs": []
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/plugins/beads-ui/core/src/**"
      ],
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}
